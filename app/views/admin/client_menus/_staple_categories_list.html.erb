<div id="staple_categories_list">
  <div class="sortable-list">
    <% items.each do |item| %>
      <div class="sortable-item menu-item" data-staple-category-id="<%= item.id %>">
        <div class="sortable-item__move">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <%= render 'admin/client_menus/staple_category',
            staple_category: item,
            client_menu: client_menu
        %>
      </div>
    <% end %>
  </div>

  <div class="save-indicator" id="staple_categories_save_indicator">
    <span class="save-indicator__icon"></span>
    <span class="save-indicator__text"></span>
  </div>

  <script>
    (function() {
      const url = '<%= admin_client_menu_update_staple_category_weights_path(client_menu) %>';
      const $list = $("#staple_categories_list .sortable-list");

      const $indicator = $('#staple_categories_save_indicator');
      const $icon = $indicator.find('.save-indicator__icon');
      const $text = $indicator.find('.save-indicator__text');
      let hideTimeout;

      function showIndicator(state, message) {
        clearTimeout(hideTimeout);
        $indicator.removeClass('save-indicator--success save-indicator--error');

        if (state === 'saving') {
          $icon.html('<span class="save-indicator__spinner"></span>');
        } else if (state === 'success') {
          $indicator.addClass('save-indicator--success');
          $icon.html('<span class="save-indicator__check">&#10003;</span>');
        } else if (state === 'error') {
          $indicator.addClass('save-indicator--error');
          $icon.html('<span class="save-indicator__error">!</span>');
        }

        $text.text(message);
        $indicator.addClass('is-visible');

        if (state !== 'saving') {
          hideTimeout = setTimeout(function() {
            $indicator.removeClass('is-visible');
          }, 2000);
        }
      }

      $list.sortable({
        handle: '.sortable-item__move',

        update: function() {
          const weights = $list.find('[data-staple-category-id]').map(function() {
            return $(this).data('staple-category-id');
          }).get();

          showIndicator('saving', 'Saving...');

          $.ajax({
            url: url,
            method: 'POST',
            data: { weights: weights },
            success: function() {
              showIndicator('success', 'Saved!');
            },
            error: function() {
              showIndicator('error', 'Something went wrong. Please try again.');
            }
          });
        }
      })
    })();
  </script>
</div>
