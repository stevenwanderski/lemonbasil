<div class="admin-header">
  <h1>Lemon Drop</h1>
  <p><%= link_to '+ Add Issue', new_admin_lemon_drop_issue_path, class: 'button' %></p>
</div>

<p>
  <%= active_link_to 'All', admin_lemon_drop_issues_path, active: params[:status].blank? %>
  <% LemonDrop::Issue.statuses.each_key do |status| %>
    · <%= active_link_to status.humanize, admin_lemon_drop_issues_path(status: status), active: params[:status] == status %>
  <% end %>
</p>

<table class="data-table">
  <thead>
    <tr>
      <th>Title</th>
      <th>Dates</th>
      <th>Status</th>
      <th>Published</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% if @issues.any? %>
      <% @issues.each do |issue| %>
        <tr data-id="<%= issue.id %>">
          <td class="data-table__primary"><%= link_to issue.title, edit_admin_lemon_drop_issue_path(issue) %></td>
          <td><%= issue.starts_on.strftime('%b %-d, %Y') %> – <%= issue.ends_on.strftime('%b %-d, %Y') %></td>
          <td><span class="status-pill status-pill--<%= issue.status %>"><%= issue.status.humanize %></span></td>
          <td class="data-table__muted"><%= issue.published_at&.strftime('%b %-d, %Y %-l:%M %p') || '—' %></td>
          <td><%= link_to 'Public view', lemon_drop_issue_path(issue.slug), target: '_blank' if issue.published? %></td>
        </tr>
      <% end %>
    <% else %>
      <tr>
        <td colspan="5" class="data-table__empty">No issues.</td>
      </tr>
    <% end %>
  </tbody>
</table>
