<div class="admin-header">
  <div>
    <h1><%= link_to @issue.title, edit_admin_lemon_drop_issue_path(@issue) %>: live editor</h1>
    <p>
      <strong><%= @issue.status.humanize %></strong>
      <% if @issue.published? %>
        · Live: changes are public when saved
      <% end %>
      · Click a Section to edit it
    </p>
  </div>
</div>

<%= tag.div class: 'live-editor', data: { controller: 'live-editor', action: 'message@window->live-editor#pick',
      live_editor_form_url_value: edit_admin_lemon_drop_issue_section_path(@issue, ':id', drawer: 1) } do %>
  <iframe class="live-editor__page" title="The Issue page" data-live-editor-target="page"
          src="<%= admin_lemon_drop_issue_preview_path(@issue, editable: 1) %>"></iframe>
  <aside class="live-editor__drawer" data-live-editor-target="drawer" hidden></aside>
<% end %>
