<%# Everything a Recipe needs, hero image included, saved together. %>
<%= form_with model: recipe, url: url, method: method do |f| %>
  <% if recipe.errors.any? %>
    <ul class="form-errors">
      <% recipe.errors.full_messages.uniq.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div class="form-item form-item--flex">
    <div>
      <%= f.label :title, class: 'label' %>
      <%= f.text_field :title, class: 'input--text' %>
    </div>
    <div>
      <%= f.label :slug, class: 'label' %>
      <%= f.text_field :slug, class: 'input--text', placeholder: 'defaults from the title' %>
    </div>
  </div>
  <div class="form-item form-item--flex">
    <div>
      <%= f.label :kicker, class: 'label' %>
      <%= f.text_field :kicker, class: 'input--text', placeholder: 'easy freeze' %>
    </div>
    <div>
      <%= f.label :category, class: 'label' %>
      <%= f.select :category, LemonDrop::Recipe.categories.keys.map { |category| [category.humanize, category] },
            { include_blank: recipe.category.blank? }, class: 'input--select' %>
    </div>
  </div>

  <fieldset class="form-fieldset">
    <legend>On the menu</legend>
    <div class="form-item">
      <%= f.label :menu_title, class: 'label' %>
      <%= f.text_field :menu_title, class: 'input--text', placeholder: 'defaults to the title' %>
    </div>
    <div class="form-item">
      <%= f.label :menu_blurb, class: 'label' %>
      <%= f.text_area :menu_blurb, rows: 2, class: 'input--textarea' %>
    </div>
  </fieldset>

  <fieldset class="form-fieldset">
    <legend>Time and servings</legend>
    <div class="form-item form-item--flex">
      <div>
        <%= f.label :prep_minutes, 'Prep minutes', class: 'label' %>
        <%= f.number_field :prep_minutes, min: 0, class: 'input--text' %>
      </div>
      <div>
        <%= f.label :time_note, class: 'label' %>
        <%= f.text_field :time_note, class: 'input--text', placeholder: '+ marinating' %>
      </div>
      <div>
        <%= f.label :cook_minutes, 'Cook minutes', class: 'label' %>
        <%= f.number_field :cook_minutes, min: 0, class: 'input--text' %>
      </div>
    </div>
    <div class="form-item form-item--flex">
      <div>
        <%= f.label :total_label, 'Total time', class: 'label' %>
        <%= f.text_field :total_label, class: 'input--text', placeholder: 'defaults to prep + cook' %>
      </div>
      <div>
        <%= f.label :serves, 'Servings', class: 'label' %>
        <%= f.number_field :serves, min: 1, class: 'input--text' %>
      </div>
    </div>
  </fieldset>

  <%= render 'admin/lemon_drop/sections/forms/image_field', f: f, name: :hero_image, label: 'Hero image', variant: :hero %>
  <div class="form-item">
    <%= f.label :hero_focus, 'Keep in view', class: 'label' %>
    <%= f.select :hero_focus, LemonDrop::Recipe.hero_focus.keys.map { |focus| [focus.humanize, focus] }, {}, class: 'input--select' %>
  </div>

  <div class="form-item">
    <span class="label">Ingredients</span>
    <p class="hint">One ingredient per line, kept as written; blank lines are skipped. Drag groups to reorder.</p>
    <%= render layout: 'admin/lemon_drop/sections/forms/nested_list', locals: { f: f, association: :ingredient_groups, add_label: '+ Add ingredient group' } do |group_form| %>
      <div class="form-item">
        <%= group_form.label :name, 'Group name', class: 'label' %>
        <%= group_form.text_field :name, class: 'input--text', placeholder: 'optional, e.g. for the sauce' %>
      </div>
      <div class="form-item">
        <%= group_form.label :ingredients_text, 'Ingredients', class: 'label' %>
        <%= group_form.text_area :ingredients_text, rows: 6, class: 'input--textarea' %>
      </div>
    <% end %>
  </div>

  <div class="form-item">
    <%= f.label :steps_text, 'Steps', class: 'label' %>
    <%= f.text_area :steps_text, rows: 8, class: 'input--textarea' %>
    <p class="hint">One step per line; blank lines are skipped.</p>
  </div>

  <div class="form-item">
    <%= f.label :tip, class: 'label' %>
    <%= f.text_area :tip, rows: 3, class: 'input--textarea' %>
  </div>

  <div class="form-actions">
    <%= f.submit 'Save', class: 'button button--submit' %>
  </div>
<% end %>
