<div class="live-editor__drawer-header">
  <button type="button" class="link" data-action="live-editor#close">← All sections</button>
  <h2><%= @recipe.persisted? ? "Recipe: #{@recipe.title_in_database}" : 'New Recipe' %></h2>
</div>

<% if @recipe.persisted? %>
  <%= button_to 'Delete Recipe', admin_lemon_drop_issue_section_recipe_path(@issue, @section, @recipe, drawer: 1), method: :delete,
        class: 'link--danger live-editor__delete',
        form: { data: { turbo: false, action: 'submit->live-editor#destroy', delete_confirm: "Delete #{@recipe.title_in_database}?" } } %>
<% end %>

<%# A new Recipe has nothing on the page yet, so it previews on Save. %>
<%= render 'form', recipe: @recipe,
      url: @recipe.persisted? ? admin_lemon_drop_issue_section_recipe_path(@issue, @section, @recipe, drawer: 1) : admin_lemon_drop_issue_section_recipes_path(@issue, @section, drawer: 1),
      method: @recipe.persisted? ? :patch : :post,
      form_options: { data: { turbo: false, action: 'submit->live-editor#save input->live-editor#preview change->live-editor#preview',
        preview_url: (preview_admin_lemon_drop_issue_section_recipe_path(@issue, @section, @recipe) if @recipe.persisted?) } } %>
