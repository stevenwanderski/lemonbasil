<%# From the live editor, the new Section opens there in the drawer. %>
<%= form_with url: admin_lemon_drop_issue_sections_path(issue), class: 'section-list__add' do |f| %>
  <%= f.label :section_type, 'Add a Section', class: 'label' %>
  <%= f.select :section_type, LemonDrop::Section::TYPES.map { |type| [type.constantize.model_name.human, type.demodulize] }, {}, class: 'input--select' %>
  <%= f.select :position, options_for_select(section_positions_for(sections), sections.size + 1), {}, class: 'input--select' %>
  <%= f.hidden_field :live_editor, value: 1 if local_assigns[:live_editor] %>
  <%= f.submit 'Add', class: 'button' %>
<% end %>
