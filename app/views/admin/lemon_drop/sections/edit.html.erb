<%= render layout: 'admin/lemon_drop/issues/editor', locals: { issue: @issue, selected: @section } do %>
  <div class="issue-editor__panel-header">
    <h2><%= @section.sectionable.model_name.human %></h2>
    <%= button_to 'Duplicate', duplicate_admin_lemon_drop_issue_section_path(@issue, @section), class: 'button' %>
    <% move_targets = recipe_move_targets(@section) %>
    <% unless move_targets.any? && @section.sectionable.recipes.any? %>
      <%= link_to 'Delete', admin_lemon_drop_issue_section_path(@issue, @section), class: 'link--danger',
            data: { turbo_method: :delete, turbo_confirm: section_delete_confirm(@section) } %>
    <% end %>
  </div>

  <% if move_targets.any? && @section.sectionable.recipes.any? %>
    <%# A Recipes Section that still has Recipes asks what happens to them. %>
    <details class="section-delete">
      <summary class="link--danger">Delete…</summary>
      <%= form_with url: admin_lemon_drop_issue_section_path(@issue, @section), method: :delete,
            data: { turbo_confirm: 'Delete this Recipes Section?' } do |df| %>
        <p>This Section has <%= pluralize(@section.sectionable.recipes.size, 'Recipe') %>.</p>
        <label class="form-item--checkbox">
          <%= df.radio_button :move_recipes_to, '', checked: true %> Delete them too
        </label>
        <% move_targets.each do |target| %>
          <label class="form-item--checkbox">
            <%= df.radio_button :move_recipes_to, target.id %> Move them to <%= recipes_section_label(target) %>
          </label>
        <% end %>
        <%= df.submit 'Delete Section', class: 'button' %>
      <% end %>
    </details>
  <% end %>

  <%= form_with model: @section, url: admin_lemon_drop_issue_section_path(@issue, @section), method: :patch do |f| %>
    <% messages = section_error_messages(@section) %>
    <% if messages.any? %>
      <ul class="form-errors">
        <% messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <% if lookup_context.exists?(@section.sectionable.model_name.element, ['admin/lemon_drop/sections/forms'], true) %>
      <%= f.fields_for :sectionable, include_id: false do |sf| %>
        <%= render "admin/lemon_drop/sections/forms/#{@section.sectionable.model_name.element}", f: sf, issue: @issue %>
      <% end %>
    <% else %>
      <p class="hint">This Section's own content can't be edited here yet. Its page settings are below.</p>
    <% end %>

    <fieldset class="form-fieldset">
      <legend>On the page</legend>
      <div class="form-item">
        <%= f.label :theme, class: 'label' %>
        <%= f.select :theme, LemonDrop::Section.themes.keys.map { |theme| [theme.humanize, theme] }, {}, class: 'input--select' %>
      </div>
      <div class="form-item">
        <%= f.label :anchor, class: 'label' %>
        <%= f.text_field :anchor, class: 'input--text' %>
      </div>
      <div class="form-item form-item--checkbox">
        <%= f.check_box :show_in_toc %>
        <%= f.label :show_in_toc, 'Show in the Table of Contents', class: 'label' %>
      </div>
      <div class="form-item">
        <%= f.label :toc_label, 'Table of Contents label', class: 'label' %>
        <%= f.text_field :toc_label, class: 'input--text', placeholder: 'defaults to the heading' %>
      </div>
    </fieldset>

    <div class="form-actions">
      <%= f.submit 'Save', class: 'button button--submit' %>
    </div>
  <% end %>
<% end %>
