<%= render layout: 'admin/lemon_drop/issues/editor', locals: { issue: @issue, selected: @section } do %>
  <div class="issue-editor__panel-header">
    <h2><%= @section.sectionable.model_name.human %></h2>
    <%= button_to 'Duplicate', duplicate_admin_lemon_drop_issue_section_path(@issue, @section), class: 'button' %>
    <% move_targets = recipe_move_targets(@section) %>
    <% unless move_targets.any? && @section.sectionable.recipes.any? %>
      <%= link_to 'Delete', admin_lemon_drop_issue_section_path(@issue, @section), class: 'link--danger',
            data: { turbo_method: :delete, turbo_confirm: section_delete_confirm(@section) } %>
    <% end %>
  </div>

  <% if move_targets.any? && @section.sectionable.recipes.any? %>
    <%# A Recipes Section that still has Recipes asks what happens to them. %>
    <details class="section-delete">
      <summary class="link--danger">Delete…</summary>
      <%= form_with url: admin_lemon_drop_issue_section_path(@issue, @section), method: :delete,
            data: { turbo_confirm: 'Delete this Recipes Section?' } do |df| %>
        <p>This Section has <%= pluralize(@section.sectionable.recipes.size, 'Recipe') %>.</p>
        <label class="form-item--checkbox">
          <%= df.radio_button :move_recipes_to, '', checked: true %> Delete them too
        </label>
        <% move_targets.each do |target| %>
          <label class="form-item--checkbox">
            <%= df.radio_button :move_recipes_to, target.id %> Move them to <%= recipes_section_label(target) %>
          </label>
        <% end %>
        <%= df.submit 'Delete Section', class: 'button' %>
      <% end %>
    </details>
  <% end %>

  <%= render 'form', section: @section, issue: @issue, url: admin_lemon_drop_issue_section_path(@issue, @section) %>
<% end %>
