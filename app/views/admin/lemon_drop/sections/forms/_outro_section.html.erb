<div class="form-item">
  <%= f.label :heading, class: 'label' %>
  <%= f.text_area :heading, rows: 2, class: 'input--textarea' %>
  <p class="hint">One line per row of large text.</p>
</div>
<div class="form-item">
  <span class="label">Photos</span>
  <% saved = f.object.images.attachments.select(&:persisted?) %>
  <% if saved.any? %>
    <ul class="image-grid">
      <% saved.each do |image| %>
        <li>
          <%= image_tag image.variant(:grid), alt: '' %>
          <%# Unchecked, the image is left out of the set saved. %>
          <label class="form-item--checkbox">
            <%= f.check_box :images, { multiple: true, checked: true, include_hidden: false, id: nil }, image.signed_id, nil %>
            Keep
          </label>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= f.file_field :images, multiple: true, accept: 'image/jpeg,image/png,image/webp' %>
  <p class="hint">Up to six JPEG, PNG or WebP photos, up to 15 MB each.</p>
</div>
<%= render 'admin/lemon_drop/sections/forms/rich_text_field', f: f, name: :body_html, label: 'Body' %>
<div class="form-item form-item--flex">
  <div>
    <%= f.label :cta_label, class: 'label' %>
    <%= f.text_field :cta_label, class: 'input--text' %>
  </div>
  <div>
    <%= f.label :cta_url, class: 'label' %>
    <%= f.text_field :cta_url, class: 'input--text', placeholder: 'https://… or mailto:…' %>
  </div>
</div>
