<%# A Tiptap editor (rich_text_controller.js) writing its HTML into a hidden field. %>
<div class="form-item">
  <%= f.label name, label, class: 'label' %>
  <div class="rich-text" data-controller="rich-text">
    <div class="rich-text__toolbar" role="toolbar">
      <button type="button" class="rich-text__button" data-rich-text-target="button" data-action="rich-text#toggleBold" data-active-name="bold" title="Bold"><strong>B</strong></button>
      <button type="button" class="rich-text__button" data-rich-text-target="button" data-action="rich-text#toggleItalic" data-active-name="italic" title="Italic"><em>I</em></button>
      <button type="button" class="rich-text__button" data-rich-text-target="button" data-action="rich-text#toggleBulletList" data-active-name="bulletList" title="Bulleted list">• List</button>
      <button type="button" class="rich-text__button" data-rich-text-target="button" data-action="rich-text#toggleOrderedList" data-active-name="orderedList" title="Numbered list">1. List</button>
      <button type="button" class="rich-text__button" data-rich-text-target="button" data-action="rich-text#showLink" data-active-name="link" title="Link">Link</button>
    </div>
    <div class="rich-text__link" data-rich-text-target="linkForm" hidden>
      <input type="url" class="input--text" placeholder="https://…" aria-label="Link URL" data-rich-text-target="linkInput"
             data-action="keydown.enter->rich-text#applyLink:prevent keydown.esc->rich-text#hideLink">
      <button type="button" class="button" data-action="rich-text#applyLink">Apply</button>
      <button type="button" class="link link--danger" data-action="rich-text#removeLink">Remove</button>
    </div>
    <div class="rich-text__editor" data-rich-text-target="editor"></div>
    <%= f.hidden_field name, data: { rich_text_target: 'input' } %>
  </div>
</div>
