</div>
<div class="form-item">
  <%= f.label :tagline, class: 'label' %>
  <%= f.text_field :tagline, class: 'input--text' %>
</div>
<div class="form-item">
  <%= f.label :date_label, class: 'label' %>
  <%= f.text_field :date_label, class: 'input--text', placeholder: issue.date_label %>
</div>
<%= render 'admin/lemon_drop/sections/forms/image_field', f: f, name: :cover_image, label: 'Cover image', variant: :cover %>
