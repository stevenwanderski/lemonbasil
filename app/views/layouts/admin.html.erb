<!DOCTYPE html>
<html>
  <head>
    <%= render 'layouts/admin_head' %>
  </head>

  <body class="admin">
    <aside class="sidebar">
      <a href="/" class="logo">
        <div>
          Lemon&amp;Basil <span>admin</span>
        </div>
      </a>

      <label class="sidebar__control" for="sidebar_menu"></label>
      <input type="checkbox" id="sidebar_menu">

      <nav>
        <ul>
          <li><%= active_link_to 'Clients', admin_clients_path %></li>
          <li><%= active_link_to 'Client Menus', admin_client_menus_path, active: :exclusive %></li>
          <li><%= active_link_to 'Monthly Menus', monthly_admin_client_menus_path %></li>
          <li><%= active_link_to 'Master Menus', master_admin_client_menus_path %></li>
          <li><%= active_link_to 'Instructions', admin_instructions_path %></li>

          <% if current_user.admin? %>
            <li><%= active_link_to 'Pages', admin_pages_path %></li>
            <li><%= active_link_to 'Users', admin_users_path %></li>
            <li><%= active_link_to 'Lemon Drop', admin_lemon_drop_issues_path %></li>
          <% end %>

          <br><br><br><br>

          <li class="email"><%= current_user.email %></li>
          <li><%= link_to 'Account', admin_account_path %></li>
          <li><%= link_to 'Logout', destroy_user_session_path %></li>
        </ul>
      </nav>
    </aside>

    <main>
      <div class="content">
        <%= render 'layouts/flash_messages' %>
        <%= yield %>
      </div>

      <div class="loading" style="display: none;">
        <span>Loading...</span>
      </div>
    </main>

    <%= turbo_frame_tag 'modal' %>
  </body>
</html>
