<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:title) ? yield(:title) : 'the lemon drop' %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800&family=Inter:wght@400;600;700&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">

    <%= favicon_link_tag asset_path('lemon.png') %>
    <%= stylesheet_link_tag 'lemon_drop', media: 'all' %>
  </head>

  <body>
    <%= yield %>

    <%= render 'layouts/analytics' %>
  </body>
</html>
