<section class="grocery-list">
  <div class="wrap">
    <div class="runner">the lemon drop</div>
    <div class="grocery-head">
      <% if grocery_list_section.icon.attached? %>
        <%= image_tag grocery_list_section.icon.variant(:icon), alt: '' %>
      <% end %>
      <h2><%= grocery_list_section.heading %></h2>
    </div>
    <div class="grocery-grid">
      <% grocery_list_section.grocery_groups.includes(:grocery_items).each do |group| %>
        <div>
          <h3><%= group.name %></h3>
          <ul>
            <% group.grocery_items.each do |item| %>
              <li><%= item.text %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
